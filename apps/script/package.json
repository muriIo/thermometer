{
  "name": "@termometro/script",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "push": "pnpm build && clasp push",
    "push:real": "pnpm build && clasp push -P .clasp.real.json",
    "chamar": "node --env-file-if-exists=.env chamar.mjs"
  },
  "devDependencies": {
    "@google/clasp": "3.4.1",
    "@types/google-apps-script": "2.0.13",
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "@termometro/contract": "workspace:*",
    "@termometro/dominio": "workspace:*"
  }
}
